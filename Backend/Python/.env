# .env - Variables de entorno para configuración del sistema
# Este archivo contiene configuración sensible y NO debe subirse a Git

# ========== CONFIGURACIÓN DE NODE.JS/EXPRESS ==========
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# URL donde está corriendo la API de Flask
FLASK_API_URL=http://localhost:5000

# ========== CONFIGURACIÓN DE BASE DE DATOS ==========
DB_HOST=10.0.1.132
DB_PORT=3306
DB_NAME=A2021_aadamaco
DB_USER=A2021_aadamaco
DB_PASSWORD=Integra2025

# ========== CONFIGURACIÓN DE SERVICIOS EXTERNOS ==========
# API_KEY_SERVICIO_EXTERNO=tu-api-key-aqui
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG...

# ========== CONFIGURACIÓN DE SEGURIDAD ==========
JWT_SECRET=otra-clave-secreta-para-tokens-jwt
ENCRYPTION_KEY=clave-para-encriptacion

# ========== CONFIGURACIÓN DE LOGGING ==========
LOG_LEVEL=info
LOG_FILE=./logs/app.log